# Copy to .env and fill in. Never commit .env.
# Ports differ from P01 (Postgres 5433, API 8000, UI 8501) so both can run together.
POSTGRES_PORT=5434
REDIS_PORT=6380
API_PORT=8001
UI_PORT=8502

# LLM (through LiteLLM). Use a NEW key for P02.
ANTHROPIC_API_KEY=

# Langfuse tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Postgres passwords: generate your own, e.g. `openssl rand -hex 16`
POSTGRES_PASSWORD=
RAG_OWNER_PASSWORD=
RAG_APP_PASSWORD=
RAG_WORKER_PASSWORD=
